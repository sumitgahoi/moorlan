# Moorlan site settings (not a wg-quick/networkd file; peers live in SQLite).
# Copy to /etc/moorlan/<iface>.conf, edit, then: sudo moorlan --add-interface <iface>
# Installed example path: /usr/share/moorlan/moorlan.conf.example

# WireGuard interface name. MUST match the filename (/etc/moorlan/wg0.conf → wg0)
# and an existing, up host device with exactly one private IPv4 (/16–/30) and zero peers.
interface=wg0

# SQLite peer database path (source of truth for enrolled phones).
db=/var/lib/moorlan/wg0.db

# LAN HTTP control plane for --pair / --unpair. Sticky private IPv4:port on a
# non-WireGuard host interface; MUST lie inside home-networks. No ephemeral port.
# Example: router/LAN address that phones can reach on home Wi-Fi.
private-endpoint=10.10.10.1:8756

# Sticky public WireGuard endpoint returned on the pair lease (DDNS or static).
# Phones use this from away. Required; no STUN/UPnP/LAN-only fallback.
public-endpoint=vpn.example.com:51820

# IPv4 prefixes phones route into the tunnel (split tunnel) for LAN access when away.
# Not hairpin / home Wi-Fi — hairpin is phone-local SSIDs. MUST NOT overlap the
# tunnel subnet. Comma-separated; include every LAN you want reachable (and the
# subnet that hosts your DNS resolver).
home-networks=10.10.0.0/24,10.10.10.0/24,10.10.20.0/24

# Required DNS resolvers for the tunnel (unicast IPv4). Order = preference.
# Use your LAN resolver (e.g. AdGuard) so names like carbon.home.arpa work in split
# tunnel; or public DNS if you have no home resolver: 1.1.1.1,1.0.0.1
dns-servers=10.10.10.53

# Optional DNS search domains (comma-separated). Short name "carbon" becomes
# carbon.home.arpa when search is home.arpa. Requires dns-servers.
dns-search=home.arpa
