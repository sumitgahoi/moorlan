[Unit]
Description=Rehydrate Moorlan WireGuard peers (systemd-networkd)
Documentation=https://github.com/sumitgahoi/moorlan/blob/main/server/README.md
# Use when moorlan0 is created by networkd (.netdev / .network).
# Requires= pulls the device in; After= alone does not wait for an absent device.
Requires=sys-subsystem-net-devices-moorlan0.device
After=sys-subsystem-net-devices-moorlan0.device network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/moorlan --rehydrate -wg moorlan0

[Install]
WantedBy=multi-user.target
