[Unit]
Description=Reconcile Moorlan WireGuard peers
Documentation=https://github.com/sumitgahoi/moorlan/blob/main/server/README.md
# moorlan --reconcile soft-fails per interface until each WireGuard device is usable;
# systemd retries within the start-limit window.
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=30

[Service]
Type=oneshot
ExecStart=/usr/local/bin/moorlan --reconcile
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
