[Unit]
Description=Reconcile Moorlan WireGuard peers
Documentation=https://github.com/sumitgahoi/moorlan/blob/main/server/README.md
# moorlan --reconcile continues across interfaces, but exits non-zero if any fail
# so systemd retries within the start-limit window while devices become usable.
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=30

[Service]
Type=oneshot
ExecStart=/usr/local/bin/moorlan --reconcile
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
