[Unit]
Description=Rehydrate Moorlan WireGuard peers (wg-quick)
Documentation=https://github.com/sumitgahoi/moorlan/blob/main/server/README.md
# Use when moorlan0 is brought up by wg-quick@moorlan0.service.
Requires=wg-quick@moorlan0.service
After=wg-quick@moorlan0.service
BindsTo=wg-quick@moorlan0.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/moorlan --rehydrate -wg moorlan0

[Install]
WantedBy=multi-user.target
